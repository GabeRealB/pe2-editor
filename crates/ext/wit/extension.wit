/// The contract between the editor and an extension built as a WebAssembly component: what the host lends an
/// extension (`host`) and what an extension exports (`guest`). The SDK (`pe2-ext`) implements both sides' Rust API
/// over it, so an extension's code is the same linked in or built as a component.
///
/// Callbacks cannot cross: what an extension registers is described by `register`'s result, each callback by a handle
/// the host calls back with (an operation's for its run, a kind's index for its outputs' members and its parts, a
/// field's for its readings, a view's or a panel's for its views, a tool's for its work). Settings cross as TOML (`4`,
/// `"indexed_4bpp"`, `{ a = 1 }`); the work graph's values as `value`.
///
/// The contract is versioned by semver, a minor version below 1.0 a line: within a line a version only adds functions to
/// `host`, so a component runs on a host of its line at least as new as what it was built against; any change to
/// `guest` or to a type is a new line. Until the editor's first release it has no outside consumers and stays at
/// 0.1.0, changing freely.
package pe2:extension@0.1.0;

/// Media as the host holds it, shaped after the `wasi:media` draft's `types` (WebAssembly/WASI#917), to become it if it
/// is standardized: frames and sound in buffers the host keeps, made from the guest's bytes once and passed by handle,
/// in the formats the host says it takes.
interface media {
    /// A frame's layout. `yuv420p`: three planes back to back - Y at full size, then Cb and Cr at half each way.
    /// `nv12`: Y, then Cb and Cr interleaved at half each way. `rgba8888` and `bgra8888`: one plane, row by row.
    enum pixel-format { rgba8888, bgra8888, yuv420p, nv12 }

    /// A stretch of sound's layout: `s16-interleaved`, 16-bit little-endian samples, the channels' interleaved;
    /// `f32-planar`, 32-bit float samples, each channel's in turn.
    enum sample-format { s16-interleaved, f32-planar }

    /// Bytes the host holds: a frame's planes, a stretch of sound.
    resource media-buffer {
        constructor(data: list<u8>);
        size: func() -> u64;
        /// A copy of its bytes.
        bytes: func() -> list<u8>;
        /// Another handle to the same bytes.
        share: func() -> media-buffer;
    }

    /// A frame: its buffer, its layout and size, when it is shown (in microseconds from its stream's start).
    record video-frame {
        buffer: media-buffer,
        format: pixel-format,
        width: u32,
        height: u32,
        timestamp: u64,
    }

    /// A stretch of sound: its buffer, its layout, rate and channels, when it begins (in microseconds).
    record audio-data {
        buffer: media-buffer,
        format: sample-format,
        sample-rate: u32,
        channels: u32,
        timestamp: u64,
    }

    /// The layouts the host takes: what a generator makes its frames and sound in, where it can.
    pixel-formats: func() -> list<pixel-format>;
    sample-formats: func() -> list<sample-format>;
}

/// What an extension declared unsandboxed has beyond WASI, which it has in full, once the user enabled it: starting
/// programs, which WASI cannot. Others are refused. What it launches - what it ships, or what it finds on the system -
/// is outside any sandbox; a command line goes no further than this component, what uses it depending on it and calling
/// its operations, not knowing what is behind them.
interface unsandboxed {
    use media.{media-buffer};

    /// A program running: what is written goes to its standard input, what it writes to its standard output is read.
    resource process {
        write: func(bytes: list<u8>) -> result<_, string>;
        /// A buffer's bytes written straight to its input: they pass through no component's memory.
        write-buffer: func(buffer: borrow<media-buffer>) -> result<_, string>;
        /// Its input ends.
        close-input: func();
        /// Up to `len` bytes of its output: none at its end.
        read: func(len: u32) -> result<list<u8>, string>;
        /// Wait for it to end, what it says on its standard error the reason where it failed.
        wait: func() -> result<_, string>;
    }

    /// Start a program: where it ships one (for this platform, in `<platform>/` of its folder, or any), else as the
    /// system finds it.
    spawn: func(tool: string, args: list<string>) -> result<process, string>;
}

interface types {
    use media.{video-frame, audio-data};

    /// Pixels as unmultiplied RGBA, row by row.
    record image {
        width: u32,
        height: u32,
        rgba: list<u8>,
    }

    record rect {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
    }

    enum icon { disc, stack, image, palette, grid, film, waveform, speaker, music, %package, terminal, text, binary, file, folder, caret-up, caret-down, cross, plus }

    enum tint { structure, picture, motion, sound, code, plain }

    enum style { normal, weak, note, strong, error }

    /// A file's content: its bytes, or a blob the host keeps, by its hash and size - read through the node an
    /// operation is lent, as its file named by the hash.
    variant content {
        inline(list<u8>),
        stored(tuple<string, u64>),
    }

    /// A file of a value's encoding: its name, its content.
    record file {
        name: string,
        content: content,
    }

    /// Audio: interleaved 16-bit samples.
    record pcm {
        rate: u32,
        channels: u16,
        samples: list<s16>,
    }

    /// A named rectangle over a picture.
    record mark {
        name: string,
        rect: rect,
    }

    /// What is marked on a node's pictures, in their pixels and the same in each look: its boxes, what they are
    /// ("12 cells"), the toggle showing them ("Cells"), each in a color of its own and named in a legend or plain.
    record marks {
        boxes: list<mark>,
        summary: string,
        toggle: string,
        legend: bool,
    }

    /// A value of a type as files (an extension's, or `bytes`): its type (qualified), the other names it answers to,
    /// its files, the settings derived with it (TOML), notes.
    record typed {
        ty: string,
        also: list<string>,
        files: list<file>,
        settings: string,
        notes: list<string>,
    }

    /// A stream given to an operation: its header (TOML), its items in turn, none at its end, waiting for each.
    resource stream-reader {
        header: func() -> string;
        next: func() -> result<option<value>, string>;
        /// Go on from an item.
        seek: func(position: u64);
    }

    /// A value that is no list (a table as TOML).
    variant item {
        image(image),
        table(string),
        pcm(pcm),
        typed(typed),
        video(video-frame),
        audio(audio-data),
        marks(marks),
    }

    /// A value: an item, or a list of items.
    variant value {
        image(image),
        table(string),
        pcm(pcm),
        typed(typed),
        video(video-frame),
        audio(audio-data),
        marks(marks),
        %stream(stream-reader),
        items(list<item>),
    }
}

interface host {
    /// The config being built: its name, release and target, and the folder its results go to.
    record build-config {
        name: string,
        release: option<string>,
        target: option<string>,
        folder: string,
    }

    use types.{image, rect, style, icon, file};

    /// An asset, lent for a call: one the host passes, or one a query of the project returns.
    resource asset {
        path: func() -> string;
        uid: func() -> option<string>;
        /// Its kind and role, qualified (`pe2.images@image`), as the host resolved them.
        kind: func() -> option<string>;
        role: func() -> option<string>;
        /// Its declaration, as written (TOML).
        declaration: func() -> string;
        has-file: func(name: string) -> bool;
        read: func(name: string) -> result<list<u8>, string>;
        /// A file's size in bytes, without reading it.
        size: func(name: string) -> option<u64>;
        /// Up to `len` bytes of a file from `offset`, read alone: fewer at its end.
        read-range: func(name: string, offset: u64, len: u32) -> result<list<u8>, string>;
        /// A file the operation it is lent to makes, named `name`, written through the host: only the node lent to an
        /// operation's run makes one.
        writer: func(name: string) -> result<writer, string>;
        /// For an unsandboxed extension's operation: a path to have a program write to, on the file system its contents are
        /// kept on.
        temp: func() -> result<string, string>;
        /// For an unsandboxed extension's operation: a file it made kept as a content, moved rather than read, named `name`.
        keep: func(path: string, name: string) -> result<file, string>;
        /// For an unsandboxed extension's operation: where a content is on disk, to point a program at it.
        path-of: func(name: string) -> option<string>;
        /// For an operation's run: the plain files under a folder of the project, each by its path, as the stack resolves it. What is
        /// made is made again when the list changes.
        entries: func(folder: string) -> result<list<string>, string>;
        /// For an operation's run: a plain file of the project by its path, as the stack resolves it. What is made is made again when it
        /// changes.
        read-entry: func(path: string) -> result<list<u8>, string>;
        /// For an operation's run: where a file or folder of the project is on disk, for what is told paths.
        place: func(path: string) -> option<string>;
        /// For an operation's run: another asset's output that is a table (TOML), recorded as read.
        table-of: func(path: string, address: string) -> result<string, string>;
        /// For an operation's run: the config being built, recorded as read.
        build-config: func() -> option<build-config>;
        /// For an operation's run: the assets of a kind, each by its path with its declaration as written. What is made is made again
        /// when any changes, or one comes or goes.
        assets-of: func(kind: string) -> result<list<tuple<string, string>>, string>;
    }

    /// A file being made, appended to a piece at a time and then finished: kept by the host as it comes - in memory
    /// while small, past that in its store - so what crosses back is its content inline, or the blob it keeps by its
    /// hash and size. A large output is never held whole in a component's memory.
    resource writer {
        append: func(bytes: list<u8>) -> result<_, string>;
        /// The file made; the writer takes no more.
        finish: func() -> result<file, string>;
    }

    /// The project, lent for a call: what an extension asks about other assets. The assets it returns are lent for
    /// the same call.
    resource project {
        asset: func(path: string) -> option<asset>;
        /// The asset a reference names (TOML: `"uid://..."`, or `{ uid, path }`).
        resolve: func(reference: string) -> option<asset>;
        find: func(kind: string) -> list<asset>;
        selection: func() -> option<asset>;
        look: func(path: string) -> u32;
        /// What the host understands of any asset, answered by the extension its kind is: its picture in a look, a
        /// part's picture, its parts (id, label, what it is made of).
        picture: func(path: string, look: u32) -> option<result<image, string>>;
        part: func(path: string, part: string) -> option<result<image, string>>;
        parts: func(path: string) -> list<tuple<string, string, list<string>>>;
        /// An output of an asset that is a table (TOML): none where it has no such output, or why it could not be made.
        table: func(path: string, address: string) -> option<result<string, string>>;
        /// A service another extension offers (`pe2.images@palette`), with its arguments (TOML): its answer (TOML). Only
        /// the services of the extensions this one requires, or its own.
        call: func(service: string, arguments: string) -> result<string, string>;
    }

    /// An image a view shows, held by the host: made once, shown by handle every frame.
    resource texture {
        constructor(key: string, image: image);
    }

    /// A table's cell: nothing (keeping its column), text, the host's chip for a reference (TOML), an icon button
    /// with what it does said on hovering it.
    variant cell {
        empty,
        text(tuple<string, style>),
        reference(string),
        button(tuple<icon, string>),
    }

    record placed {
        rect: rect,
        label: option<string>,
        link: option<string>,
    }

    record marked {
        name: string,
        rect: rect,
        highlight: bool,
    }

    /// Images on a canvas the host zooms and pans, with named boxes over them.
    record canvas {
        width: f32,
        height: f32,
        pictures: list<tuple<borrow<texture>, placed>>,
        boxes: list<marked>,
        summary: string,
        toggle: string,
        legend: bool,
        grid: option<tuple<f32, f32>>,
    }

    /// The host's UI, lent to a view for a frame; a row, a section or a collapsing body of it is drawn on until it is
    /// dropped.
    resource ui {
        label: func(text: string, style: style);
        /// A texture published through `gpu`, at this size.
        gpu-image: func(id: u64, width: f32, height: f32);
        button: func(text: string) -> bool;
        /// A button showing an icon of the host's set, what it does said on hovering it; whether it was clicked.
        icon-button: func(icon: icon, hint: string) -> bool;
        /// A checkbox showing `value`; its value after this frame.
        checkbox: func(text: string, value: bool) -> bool;
        badge: func(text: string);
        /// A small framed name, marked where `selected`; whether it was clicked.
        chip: func(text: string, selected: bool) -> bool;
        image: func(texture: borrow<texture>, width: f32, height: f32);
        /// The host's chip for a reference (TOML), opening its asset.
        reference: func(reference: string);
        /// A field, the host's way: its label and its reading (TOML value).
        field: func(key: string, value: string);
        tooltip: func(text: string);
        /// A one-line text field showing `text`; its text after this frame, and whether it was committed.
        text-edit: func(id: string, text: string) -> tuple<string, bool>;
        /// A dropdown; the option chosen this frame.
        combo: func(id: string, selected: string, options: list<string>) -> option<u32>;
        /// Whether the asset shown can be edited.
        editable: func() -> bool;
        /// Set a field of the asset shown (TOML), or remove it.
        set: func(key: string, value: option<string>);
        horizontal: func() -> ui;
        wrapped: func() -> ui;
        indented: func() -> ui;
        section: func(title: string) -> ui;
        collapsing: func(id: string, title: string, note: string) -> option<ui>;
        canvas: func(canvas: canvas);
        /// Rows of cells in aligned columns, `id` keeping its widths: the cell of a button clicked this frame (its
        /// row, its column).
        table: func(id: string, rows: list<list<cell>>) -> option<tuple<u32, u32>>;
        /// An asset's picture in a look as the host draws it - once, off the window's thread, shared by all that show
        /// it - with its width and height: none while it is being drawn (the view is drawn again when it is).
        picture: func(path: string, look: u32) -> option<result<tuple<texture, u32, u32>, string>>;
        navigate: func(path: string);
        /// The part selected of the asset shown: its fragment (`cells/cursor`).
        selected: func() -> option<string>;
        /// Select a part of the asset shown, as clicking it anywhere would.
        select: func(part: string);
    }

    /// The declarations, lent to an extraction session's beginning.
    resource declarations {
        /// Every declaration of a kind (as declared: `file`, `image`, `vram_slot`), by path in path order, as TOML.
        of-kind: func(kind: string) -> list<tuple<string, string>>;
    }

    /// A release's discs, lent for one asset's extraction.
    resource discs {
        /// A chunk's payload, by a location as a declaration gives it (TOML: `{ stage, folder, file, slot }`), or a
        /// disc slot's bytes (`{ disc, slot }`).
        read: func(at: string) -> result<list<u8>, string>;
        /// The size of what `read` gives at a location, without reading it.
        size: func(at: string) -> result<u64, string>;
        /// Up to `len` bytes of what `read` gives at a location, from `offset`, read alone: a disc slot of hundreds of
        /// megabytes (a movie file) is never read whole.
        read-range: func(at: string, offset: u64, len: u32) -> result<list<u8>, string>;
    }

    log: func(message: string);
    /// The settings kept for this extension, by scope, as TOML: `{ project = { ... }, user = { ... } }`. Read as it
    /// registers; a change loads it again.
    settings: func() -> string;
}

interface guest {
    use types.{image, rect, icon, tint, value};
    use host.{asset, project, ui, declarations, discs};

    /// An extension: its id, its version, what it requires (`pe2.images@^0.1`).
    record about {
        id: string,
        version: string,
        requires: list<string>,
        /// What it uses where a compatible one is enabled, and is turned off with once linked.
        weak: list<string>,
        /// What it uses where a compatible one is enabled.
        optional: list<string>,
        /// The services it offers, by name and version: what requires one takes whichever provides it.
        provides: list<string>,
        /// The platforms it runs on (`linux-x86_64`); none, any.
        platforms: list<string>,
        /// It runs outside the sandbox: it runs only once the user enabled it.
        unsandboxed: bool,
    }

    /// A field, its readings by handle.
    record field {
        handle: u32,
        key: string,
        label: option<string>,
        format: bool,
        brief: bool,
        choices: list<tuple<string, string>>,
        read-only: bool,
        custom: bool,
    }

    /// The place a view has of its own, an inspector's tab or an editor beside the preview: its icon, and the fields that bring
    /// it, it being shown for an asset with any of them (with none named, for every asset).
    record tab {
        icon: icon,
        fields: list<string>,
    }

    /// A view or a panel's view, by handle; in the inspector, with a tab of its own or among the properties.
    record view {
        handle: u32,
        name: string,
        tab: option<tab>,
    }

    /// What can be done to a row of the contents, or to the pane: its id, how it reads, its icon. With `on-row`, a button on the
    /// row itself rather than an entry of its menu, `on` holding it down: a row's visibility.
    record content-action {
        id: string,
        label: string,
        icon: option<icon>,
        on-row: bool,
        on: bool,
    }

    /// How a row reads: an `item` is selected, `dim` greyed (left out, hidden), a `heading` only names those under it.
    enum content-style { item, dim, heading }

    /// A row dragged: what it is, which rows that `take` it hold, and whether those of the same `what` go around it.
    record content-drag {
        what: string,
        reorders: bool,
    }

    /// A row of what is inside an asset: what selecting it selects, how it reads, what it says beside that and on hovering it,
    /// how deep in the tree it is; a row deeper than the one before it is under that one, which folds, `open` being how it
    /// starts. Its `icon` and tint, `picture` showing its part's picture instead. `look`, one of its asset's looks, is what the
    /// asset is shown in once it is selected. `link`, an asset's path, is opened by a double-click. `rename` offers renaming it. `drag` is what it is when dragged, `takes` what it holds. What comes of each
    /// of these is `content-act`'s.
    record content-row {
        id: string,
        label: string,
        detail: string,
        hint: string,
        depth: u32,
        style: content-style,
        icon: option<tuple<icon, tint>>,
        picture: bool,
        open: bool,
        look: option<u32>,
        link: option<string>,
        rename: bool,
        drag: option<content-drag>,
        takes: list<string>,
        actions: list<content-action>,
    }

    /// What is inside an asset: its rows, what the pane offers above them, and whether its stack follows them.
    record asset-contents {
        rows: list<content-row>,
        actions: list<content-action>,
        stack: bool,
    }

    /// Where a row dragged lands by the row it is dropped on.
    enum content-place { before, inside, after }

    /// What was done in the contents: an action of a row (empty: of the pane), a row renamed, a row dragged onto another.
    variant content-request {
        action(tuple<string, string>),
        rename(tuple<string, string>),
        moved(tuple<string, string, content-place>),
    }

    /// A value of the declaration set, by its path (each step a key, or a list's place), or removed.
    record content-set {
        path: list<string>,
        value: option<string>,
    }

    /// What comes of it: its name in the history, what it changes in the declaration, what is selected after it.
    record content-outcome {
        label: string,
        sets: list<content-set>,
        select: option<string>,
    }

    /// A field of a part in the inspector: its value (TOML; none: left out, reading as `absent`), what it can be set to.
    record part-field {
        key: string,
        label: string,
        value: option<string>,
        absent: option<string>,
        choices: list<tuple<string, string>>,
        read-only: bool,
    }

    /// A part's fields, and the table of the declaration they are in.
    record part-sheet {
        within: list<string>,
        fields: list<part-field>,
    }

    /// How an output is kept: in the project's store, in its build directory, or not at all.
    enum retain { cache, build, transient }

    /// An output a kind declares on every node of it: made by an operation (qualified) from the node's stack's result
    /// - a family where the operation has a parameter, its members called back by the kind's index and the output's.
    record output {
        name: string,
        op: string,
        retain: retain,
        members: bool,
        /// The output of its kind it is made from; none, its node's result.
        %from: option<string>,
    }

    /// A kind; its outputs' members and its parts called back by its index.
    record kind {
        name: string,
        alias: option<string>,
        label: string,
        icon: option<tuple<icon, tint>>,
        fields: list<field>,
        parts: bool,
        /// Whether it says what is inside its assets, rather than that following from their parts.
        contents: bool,
        /// Whether it says what a part's fields are, rather than those being what its table holds.
        part-sheet: bool,
        views: list<view>,
        inspector: list<view>,
        /// Editors of its own, beside the preview: each of these a document can show instead of it.
        editors: list<view>,
        /// Views at the head of the contents pane, over its rows: what rows cannot say.
        contents-views: list<view>,
        outputs: list<output>,
        /// The stack a node of it has where its bundle states none (TOML `[[stack]]` tables).
        stack: option<string>,
    }

    record role {
        name: string,
        /// Qualified: a role may be on a dependency's kind.
        kind: string,
        alias: option<string>,
        label: string,
        fields: list<field>,
        views: list<view>,
        inspector: list<view>,
        /// Editors of its own, beside the preview: each of these a document can show instead of it.
        editors: list<view>,
        /// Views at the head of the contents pane, over its rows: what rows cannot say.
        contents-views: list<view>,
    }

    record panel {
        handle: u32,
        name: string,
        label: string,
        icon: option<icon>,
    }

    record tool {
        handle: u32,
        name: string,
        description: string,
        /// Its arguments, as a JSON schema.
        schema: string,
    }

    /// How the host recognizes a type in a file without calling back: bytes at an offset, a file name (exact, or `*`
    /// and a suffix), or text.
    variant signature {
        bytes(tuple<u32, list<u8>>),
        name(string),
        text,
    }


    /// A port of an operation: what it takes (a type as written: `pe2.formats@ora`, `a | b`, `file<T>`, `image`, `T`,
    /// `any`), and whether any number of values.
    record port {
        name: string,
        ty: string,
        many: bool,
    }

    /// An operation; its run called back by its handle.
    record op {
        handle: u32,
        name: string,
        label: string,
        inputs: list<port>,
        output: string,
        fields: list<field>,
        /// The settings of its node it derives (`size`, `cells.*.rect`).
        derives: list<string>,
        /// The operation undoing it, qualified.
        inverse: option<string>,
        /// Its parameter: its name, and the kind of value it takes (`name`, `number`).
        parameter: option<tuple<string, string>>,
        priority: s32,
    }

    /// A type of the extension's own: with a recognizer - signatures, a sniff called back by its handle, a media type
    /// it answers to - a stored file is recognized as it.
    record value-type {
        handle: u32,
        name: string,
        label: string,
        media-type: option<string>,
        signatures: list<signature>,
        sniff: bool,
    }

    /// An extractor: the native files of a kind's assets (of some of its roles, qualified; all where none) from the
    /// discs, in sessions (`extraction`).
    record extractor {
        handle: u32,
        name: string,
        kind: string,
        roles: list<string>,
    }

    /// Where a setting is kept: the project's (the same for everyone on it) or the user's (a preference).
    enum scope { project, user }

    /// A setting, as declared, and the value it took (TOML).
    record setting {
        key: string,
        label: option<string>,
        help: option<string>,
        default: string,
        scope: scope,
        choices: list<tuple<string, string>>,
    }

    /// How a file replaces what an asset is made of: a kind's assets, the files of a name (`*.mp4`), and the stack they
    /// then have (TOML), the file written `{file}`.
    record recipe {
        kind: string,
        pattern: string,
        stack: string,
    }

    /// An operation run where an event is signaled.
    record hook {
        event: string,
        /// The operation, qualified.
        op: string,
        /// The events it signals, where it succeeds.
        signals: list<string>,
    }

    record registration {
        kinds: list<kind>,
        /// The events it declares, by name, with their labels.
        events: list<tuple<string, string>>,
        hooks: list<hook>,
        roles: list<role>,
        panels: list<panel>,
        tools: list<tool>,
        /// Services, for other extensions: described as tools are.
        services: list<tool>,
        ops: list<op>,
        types: list<value-type>,
        extractors: list<extractor>,
        /// Outputs it adds to kinds of what it requires, by the kind's qualified name.
        additions: list<tuple<string, output>>,
        /// The stacks it gives kinds of what it requires that have none, by the kind's qualified name (TOML).
        stacks: list<tuple<string, string>>,
        /// What files replace assets of kinds, with what.
        recipes: list<recipe>,
        /// Commands: each a label, and the tool of its own it runs, with no arguments.
        commands: list<tuple<string, string>>,
        /// The memory a job of something it registered may take, where more than the host's default: by its name
        /// (qualified), in bytes.
        memory: list<tuple<string, u64>>,
        settings: list<setting>,
    }

    describe: func() -> about;
    /// Run the extension's entry point.
    register: func() -> result<registration, string>;

    /// An operation's run: lent its node as an asset - its path, kind, role and declared settings, its files the
    /// contents its values hold, named by their hashes - given its values by port, its settings (TOML) and its output's
    /// parameter.
    run-op: async func(op: u32, node: borrow<asset>, inputs: list<list<value>>, settings: string, parameter: option<string>) -> result<value, string>;
    /// A family's members, of an asset: each by its parameter's value, with a label. An added output goes by its place
    /// after the kinds, as `kind`.
    members: func(kind: u32, output: u32, asset: borrow<asset>) -> list<tuple<string, string>>;
    /// A field's reading of a value (`brief`: within a list's row).
    format: func(field: u32, brief: bool, value: string) -> option<string>;
    /// A part of an asset, by its fragment; a virtual one made of others.
    record part {
        id: string,
        label: string,
        made-of: list<string>,
    }

    /// An asset's parts, in order.
    parts: func(kind: u32, asset: borrow<asset>) -> list<part>;
    /// What is inside an asset, in order.
    contents: func(kind: u32, asset: borrow<asset>) -> asset-contents;
    /// What comes of something done in the contents: why it cannot be, where it cannot.
    content-act: func(kind: u32, asset: borrow<asset>, request: content-request) -> result<content-outcome, string>;
    /// A part's fields, by its fragment.
    part-sheet-of: func(kind: u32, asset: borrow<asset>, part: string) -> option<part-sheet>;
    /// A type's sniff: a file's name, size and first bytes to its version (empty where it has none), or not this.
    sniff: func(ty: u32, name: string, size: u64, head: list<u8>) -> option<string>;
    /// Whether this instance may be reclaimed: asked before the host drops a long-running instance (its views' when the
    /// last closes), which keeps it when it says no - it holds what it cannot rebuild cheaply.
    reclaimable: func() -> bool;
    /// A service's work, called by another extension through the host: its arguments (TOML) to its answer (TOML).
    serve: async func(service: u32, project: borrow<project>, arguments: string) -> result<string, string>;
    /// A tool's work: its arguments (TOML) to its answer (TOML).
    run: async func(tool: u32, project: borrow<project>, arguments: string) -> result<string, string>;

    /// An extraction session: begun with the declarations, then an asset at a time.
    resource extraction {
        begin: static async func(extractor: u32, declarations: borrow<declarations>) -> result<extraction, string>;
        /// An asset's native files for a release, checked against its declaration.
        extract: async func(path: string, release: string, discs: borrow<discs>) -> result<list<tuple<string, list<u8>>>, string>;
    }

    /// A view, kept between frames: of an asset, or a panel's (no asset).
    resource view-state {
        constructor(view: u32, asset: option<borrow<asset>>);
        show: func(ui: borrow<ui>, project: borrow<project>, asset: option<borrow<asset>>, look: u32);
    }

    /// What makes a stream's items (`start-stream`), living in an instance of its own while the stream is read: its
    /// header (TOML), up to `count` items after the last (fewer at its end), going on from an item elsewhere where it
    /// can. Each call is lent the node it was started for - its settings, its files the contents its values hold, by
    /// hash - through which it reads what it kept.
    resource generator {
        header: func() -> string;
        next: func(node: borrow<asset>, count: u32) -> result<list<value>, string>;
        seek: func(node: borrow<asset>, position: u64) -> result<bool, string>;
    }

    /// A stream operation opened: lent its node, given its values by port, its settings and its output's parameter
    /// (as `run-op`), it starts its generator.
    start-stream: func(op: u32, node: borrow<asset>, inputs: list<list<value>>, settings: string, parameter: option<string>) -> result<generator, string>;
}

/// The GPU, for what shows itself in a view: the device the editor draws with, and a texture of it made known to `ui.gpu-image`.
interface gpu {
    use wasi:webgpu/webgpu@0.3.0-rc.2.{gpu-device, gpu-texture};

    /// None where nothing draws: the command line, the MCP server.
    device: func() -> option<gpu-device>;
    /// What `ui.gpu-image` knows a texture by, while it is kept: publishing it again gives the same.
    publish: func(texture: borrow<gpu-texture>) -> u64;
    /// The window lets go of a published texture.
    unpublish: func(id: u64);
}

/// What every host links.
world linked {
    import host;
    import unsandboxed;
    export guest;
}

/// An extension: and the GPU, which only a host that draws links. Elsewhere calling it traps.
world extension {
    include linked;
    import wasi:webgpu/webgpu@0.3.0-rc.2;
    import gpu;
}
