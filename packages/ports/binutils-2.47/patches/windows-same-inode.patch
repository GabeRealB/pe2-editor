On Windows, stat gives no inode (st_ino 0) and the drive's number as st_dev, so binutils took any two files on one
drive for the same file: ld refused a second linker script ("appears multiple times"). A file with no inode is not
known to be another.

--- a/include/same-inode.h
+++ b/include/same-inode.h
@@ -28,10 +28,10 @@
      && (a).st_dev == (b).st_dev)
 # elif defined _WIN32 && ! defined __CYGWIN__
    /* Native Windows.  */
-   /* stat() and fstat() set st_dev and st_ino to 0 if information about
-      the inode is not available.  */
+   /* stat() and fstat() set st_ino to 0, there being no inodes, and st_dev to
+      the drive's number: two files with no inode are not known to be one.  */
 #  define SAME_INODE(a, b) \
-    (!((a).st_ino == 0 && (a).st_dev == 0) \
+    ((a).st_ino != 0 \
      && (a).st_ino == (b).st_ino && (a).st_dev == (b).st_dev)
 # else
 #  define SAME_INODE(a, b)    \
