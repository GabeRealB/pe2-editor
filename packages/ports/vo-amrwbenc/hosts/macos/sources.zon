                        "src:amrwbenc/src/util.c",
                        "src:amrwbenc/src/voAMRWBEnc.c",
                        "src:amrwbenc/src/voicefac.c",
                        "src:amrwbenc/src/wb_vad.c",
                        "src:amrwbenc/src/weight_a.c",
                    },
                },
            },
        },
    },
