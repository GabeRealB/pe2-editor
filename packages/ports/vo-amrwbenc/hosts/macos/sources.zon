// What the library's own build compiled for this host, harvested from it: each library's sources, in groups
// compiled alike. `src:` names a file of the sources, `build:` one its build generated (in `build/` here).
.{
    .libraries = .{
        .{
            .name = "vo-amrwbenc",
            .groups = .{
                .{
                    .kind = .c,
                    .flags = .{
                        "-DPACKAGE_NAME=\"vo-amrwbenc\"",
                        "-DPACKAGE_TARNAME=\"vo-amrwbenc\"",
                        "-DPACKAGE_VERSION=\"0.1.3\"",
                        "-DPACKAGE_STRING=\"vo-amrwbenc 0.1.3\"",
                        "-DPACKAGE_BUGREPORT=\"http://sourceforge.net/projects/opencore-amr/\"",
                        "-DPACKAGE_URL=\"\"",
                        "-DPACKAGE=\"vo-amrwbenc\"",
                        "-DVERSION=\"0.1.3\"",
                        "-DSTDC_HEADERS=1",
                        "-DHAVE_SYS_TYPES_H=1",
                        "-DHAVE_SYS_STAT_H=1",
                        "-DHAVE_STDLIB_H=1",
                        "-DHAVE_STRING_H=1",
                        "-DHAVE_MEMORY_H=1",
                        "-DHAVE_STRINGS_H=1",
                        "-DHAVE_INTTYPES_H=1",
                        "-DHAVE_STDINT_H=1",
                        "-DHAVE_UNISTD_H=1",
                        "-DHAVE_DLFCN_H=1",
                        "-DLT_OBJDIR=\".libs/\"",
                        "-O2",
                    },
                    .include = .{
                        "build:",
                        "src:",
                        "src:amrwbenc/inc",
                        "src:common/include",
                    },
                    .path_flags = .{},
                    .files = .{
                        "src:wrapper.c",
                        "src:common/cmnMemory.c",
                        "src:amrwbenc/src/autocorr.c",
                        "src:amrwbenc/src/az_isp.c",
                        "src:amrwbenc/src/bits.c",
                        "src:amrwbenc/src/c2t64fx.c",
                        "src:amrwbenc/src/c4t64fx.c",
                        "src:amrwbenc/src/convolve.c",
                        "src:amrwbenc/src/cor_h_x.c",
                        "src:amrwbenc/src/decim54.c",
                        "src:amrwbenc/src/deemph.c",
                        "src:amrwbenc/src/dtx.c",
                        "src:amrwbenc/src/g_pitch.c",
                        "src:amrwbenc/src/gpclip.c",
                        "src:amrwbenc/src/homing.c",
                        "src:amrwbenc/src/hp400.c",
                        "src:amrwbenc/src/hp50.c",
                        "src:amrwbenc/src/hp6k.c",
                        "src:amrwbenc/src/hp_wsp.c",
                        "src:amrwbenc/src/int_lpc.c",
                        "src:amrwbenc/src/isp_az.c",
                        "src:amrwbenc/src/isp_isf.c",
                        "src:amrwbenc/src/lag_wind.c",
                        "src:amrwbenc/src/levinson.c",
                        "src:amrwbenc/src/log2.c",
                        "src:amrwbenc/src/lp_dec2.c",
                        "src:amrwbenc/src/math_op.c",
                        "src:amrwbenc/src/mem_align.c",
                        "src:amrwbenc/src/oper_32b.c",
                        "src:amrwbenc/src/p_med_ol.c",
                        "src:amrwbenc/src/pit_shrp.c",
                        "src:amrwbenc/src/pitch_f4.c",
                        "src:amrwbenc/src/pred_lt4.c",
                        "src:amrwbenc/src/preemph.c",
                        "src:amrwbenc/src/q_gain2.c",
                        "src:amrwbenc/src/q_pulse.c",
                        "src:amrwbenc/src/qisf_ns.c",
