// What the library's own build compiled for this host, harvested from it: each library's sources, in groups
// compiled alike. `src:` names a file of the sources, `build:` one its build generated (in `build/` here).
.{
    .libraries = .{
        .{
            .name = "lcms2",
            .groups = .{
                .{
                    .kind = .c,
                    .flags = .{
                        "-DPACKAGE_NAME=\"lcms2\"",
                        "-DPACKAGE_TARNAME=\"lcms2\"",
                        "-DPACKAGE_VERSION=\"2.20\"",
                        "-DPACKAGE_STRING=\"lcms2 2.20\"",
                        "-DPACKAGE_BUGREPORT=\"\"",
                        "-DPACKAGE_URL=\"\"",
                        "-DHAVE_STDIO_H=1",
                        "-DHAVE_STDLIB_H=1",
                        "-DHAVE_STRING_H=1",
                        "-DHAVE_INTTYPES_H=1",
                        "-DHAVE_STDINT_H=1",
                        "-DHAVE_STRINGS_H=1",
                        "-DHAVE_SYS_STAT_H=1",
                        "-DHAVE_SYS_TYPES_H=1",
                        "-DHAVE_UNISTD_H=1",
                        "-DSTDC_HEADERS=1",
                        "-DHAVE_DLFCN_H=1",
                        "-DLT_OBJDIR=\".libs/\"",
                        "-DHAVE_FUNC_ATTRIBUTE_VISIBILITY=1",
                        "-DHAVE_GMTIME_R=1",
                        "-DHAVE_PTHREAD_PRIO_INHERIT=1",
                        "-DHAVE_PTHREAD=1",
                        "-DHasTHREADS=1",
                        "-O2",
                        "-fvisibility=hidden",
                        "-pthread",
                    },
                    .include = .{
                        "build:src",
                        "src:src",
                        "build:include",
                        "src:include",
                    },
                    .path_flags = .{},
                    .files = .{
                        "src:src/cmscnvrt.c",
                        "src:src/cmserr.c",
                        "src:src/cmsgamma.c",
                        "src:src/cmsgmt.c",
                        "src:src/cmsintrp.c",
                        "src:src/cmsio0.c",
                        "src:src/cmsio1.c",
                        "src:src/cmslut.c",
                        "src:src/cmsplugin.c",
                        "src:src/cmssm.c",
                        "src:src/cmsmd5.c",
                        "src:src/cmsmtrx.c",
                        "src:src/cmspack.c",
                        "src:src/cmspcs.c",
                        "src:src/cmswtpnt.c",
                        "src:src/cmsxform.c",
                        "src:src/cmssamp.c",
                        "src:src/cmsnamed.c",
                        "src:src/cmscam02.c",
                        "src:src/cmsvirt.c",
                        "src:src/cmstypes.c",
                        "src:src/cmscgats.c",
                        "src:src/cmsps2.c",
                        "src:src/cmsopt.c",
                        "src:src/cmshalf.c",
                        "src:src/cmsalpha.c",
                    },
                },
            },
        },
    },
}
