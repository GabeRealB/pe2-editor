// What the library's own build compiled for this host, harvested from it: each library's sources, in groups
// compiled alike. `src:` names a file of the sources, `build:` one its build generated (in `build/` here).
.{
    .libraries = .{
        .{
            .name = "dav1d",
            .groups = .{
                .{
                    .kind = .c,
                    .flags = .{
                        "-DNDEBUG",
                        "-std=c99",
                        "-O3",
                        "-fvisibility=hidden",
                        "-fomit-frame-pointer",
                        "-ffast-math",
                        "-fno-align-functions",
                        "-DBITDEPTH=8",
                    },
                    .include = .{
                        "build:src/libdav1d_bitdepth_8.a.p",
                        "build:src",
                        "src:src",
                        "build:",
                        "src:",
                        "build:include/dav1d",
                        "src:include/dav1d",
                        "build:include",
                        "src:include",
