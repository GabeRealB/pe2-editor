// What the library's own build compiled for this host, harvested from it: each library's sources, in groups
// compiled alike. `src:` names a file of the sources, `build:` one its build generated (in `build/` here).
.{
    .libraries = .{
        .{
            .name = "xvidcore",
            .groups = .{
                .{
                    .kind = .c,
                    .flags = .{
                        "-DARCH_IS_GENERIC",
                        "-DARCH_IS_64BIT",
                        "-DARCH_IS_LITTLE_ENDIAN",
                        "-fPIC",
                        "-fno-common",
                        "-no-cpp-precomp",
                        "-DHAVE_PTHREAD",
                        "-O2",
                        "-fstrength-reduce",
                        "-finline-functions",
                        "-ffast-math",
                        "-fomit-frame-pointer",
                    },
                    .include = .{},
                    .path_flags = .{},
                    .files = .{
                        "src:src/decoder.c",
                        "src:src/encoder.c",
                        "src:src/xvid.c",
                        "src:src/bitstream/bitstream.c",
                        "src:src/bitstream/cbp.c",
                        "src:src/bitstream/mbcoding.c",
                        "src:src/dct/fdct.c",
                        "src:src/dct/idct.c",
                        "src:src/dct/simple_idct.c",
                        "src:src/image/colorspace.c",
                        "src:src/image/image.c",
                        "src:src/image/interpolate8x8.c",
                        "src:src/image/font.c",
                        "src:src/image/postprocessing.c",
                        "src:src/image/qpel.c",
                        "src:src/image/reduced.c",
                        "src:src/motion/estimation_bvop.c",
                        "src:src/motion/estimation_common.c",
                        "src:src/motion/estimation_gmc.c",
                        "src:src/motion/estimation_pvop.c",
                        "src:src/motion/estimation_rd_based.c",
                        "src:src/motion/estimation_rd_based_bvop.c",
                        "src:src/motion/gmc.c",
                        "src:src/motion/motion_comp.c",
                        "src:src/motion/vop_type_decision.c",
                        "src:src/motion/sad.c",
                        "src:src/prediction/mbprediction.c",
                        "src:src/plugins/plugin_single.c",
                        "src:src/plugins/plugin_2pass1.c",
                        "src:src/plugins/plugin_2pass2.c",
                        "src:src/plugins/plugin_lumimasking.c",
                        "src:src/plugins/plugin_dump.c",
                        "src:src/plugins/plugin_psnr.c",
                        "src:src/plugins/plugin_ssim.c",
                        "src:src/plugins/plugin_psnrhvsm.c",
                        "src:src/quant/quant_h263.c",
                        "src:src/quant/quant_matrix.c",
                        "src:src/quant/quant_mpeg.c",
                        "src:src/utils/emms.c",
                        "src:src/utils/mbtransquant.c",
                        "src:src/utils/mem_align.c",
                        "src:src/utils/mem_transfer.c",
                        "src:src/utils/timer.c",
                    },
                },
            },
        },
    },
}
