// What the library's own build compiled for this host, harvested from it: each library's sources, in groups
// compiled alike. `src:` names a file of the sources, `build:` one its build generated (in `build/` here).
.{
    .libraries = .{
        .{
            .name = "zimg",
            .groups = .{
                .{
                    .kind = .cpp,
                    .flags = .{
                        "-DPACKAGE_NAME=\"zimg\"",
                        "-DPACKAGE_TARNAME=\"zimg\"",
                        "-DPACKAGE_VERSION=\"3.0.6\"",
                        "-DPACKAGE_STRING=\"zimg 3.0.6\"",
                        "-DPACKAGE_BUGREPORT=\"https://github.com/sekrit-twc/zimg/pulls\"",
                        "-DPACKAGE_URL=\"https://github.com/sekrit-twc/zimg\"",
                        "-DHAVE_STDIO_H=1",
                        "-DHAVE_STDLIB_H=1",
                        "-DHAVE_STRING_H=1",
                        "-DHAVE_INTTYPES_H=1",
                        "-DHAVE_STDINT_H=1",
                        "-DHAVE_STRINGS_H=1",
                        "-DHAVE_SYS_STAT_H=1",
                        "-DHAVE_SYS_TYPES_H=1",
                        "-DHAVE_UNISTD_H=1",
                        "-DSTDC_HEADERS=1",
                        "-DHAVE_DLFCN_H=1",
                        "-DLT_OBJDIR=\".libs/\"",
                        "-DHAVE_PTHREAD_PRIO_INHERIT=1",
                        "-DHAVE_PTHREAD=1",
                        "-DZIMG_ARM=1",
                        "-std=c++14",
                        "-O2",
                        "-DNDEBUG",
                        "-pthread",
                        "-fvisibility=hidden",
                    },
                    .include = .{
                        "build:",
                        "src:",
                    },
                    .path_flags = .{},
                    .files = .{
                        "src:dummy.cpp",
                    },
                },
                .{
                    .kind = .cpp,
                    .flags = .{
                        "-DPACKAGE_NAME=\"zimg\"",
                        "-DPACKAGE_TARNAME=\"zimg\"",
                        "-DPACKAGE_VERSION=\"3.0.6\"",
                        "-DPACKAGE_STRING=\"zimg 3.0.6\"",
                        "-DPACKAGE_BUGREPORT=\"https://github.com/sekrit-twc/zimg/pulls\"",
                        "-DPACKAGE_URL=\"https://github.com/sekrit-twc/zimg\"",
                        "-DHAVE_STDIO_H=1",
                        "-DHAVE_STDLIB_H=1",
                        "-DHAVE_STRING_H=1",
                        "-DHAVE_INTTYPES_H=1",
                        "-DHAVE_STDINT_H=1",
                        "-DHAVE_STRINGS_H=1",
                        "-DHAVE_SYS_STAT_H=1",
                        "-DHAVE_SYS_TYPES_H=1",
                        "-DHAVE_UNISTD_H=1",
                        "-DSTDC_HEADERS=1",
                        "-DHAVE_DLFCN_H=1",
                        "-DLT_OBJDIR=\".libs/\"",
                        "-DHAVE_PTHREAD_PRIO_INHERIT=1",
                        "-DHAVE_PTHREAD=1",
                        "-DZIMG_ARM=1",
                        "-std=c++14",
                        "-O2",
                        "-DNDEBUG",
                        "-pthread",
                        "-fvisibility=hidden",
                    },
                    .include = .{
                        "build:",
                        "src:",
                        "src:src/zimg",
                    },
                    .path_flags = .{},
                    .files = .{
                        "src:src/zimg/depth/arm/depth_convert_neon.cpp",
                        "src:src/zimg/depth/arm/dither_neon.cpp",
                        "src:src/zimg/depth/arm/f16c_neon.cpp",
