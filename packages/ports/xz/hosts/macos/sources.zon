// What the library's own build compiled for this host, harvested from it: each library's sources, in groups
// compiled alike. `src:` names a file of the sources, `build:` one its build generated (in `build/` here).
.{
    .libraries = .{
        .{
            .name = "lzma",
            .groups = .{
                .{
                    .kind = .c,
                    .flags = .{
                        "-DHAVE_ARM64_CRC32",
                        "-DHAVE_CHECK_CRC32",
                        "-DHAVE_CHECK_CRC64",
                        "-DHAVE_CHECK_SHA256",
                        "-DHAVE_CLOCK_GETTIME",
                        "-DHAVE_CLOCK_MONOTONIC",
                        "-DHAVE_DECODERS",
                        "-DHAVE_DECODER_ARM",
                        "-DHAVE_DECODER_ARM64",
                        "-DHAVE_DECODER_ARMTHUMB",
                        "-DHAVE_DECODER_DELTA",
                        "-DHAVE_DECODER_IA64",
                        "-DHAVE_DECODER_LZMA1",
                        "-DHAVE_DECODER_LZMA2",
                        "-DHAVE_DECODER_POWERPC",
                        "-DHAVE_DECODER_RISCV",
                        "-DHAVE_DECODER_SPARC",
                        "-DHAVE_DECODER_X86",
                        "-DHAVE_ENCODERS",
                        "-DHAVE_ENCODER_ARM",
                        "-DHAVE_ENCODER_ARM64",
                        "-DHAVE_ENCODER_ARMTHUMB",
                        "-DHAVE_ENCODER_DELTA",
                        "-DHAVE_ENCODER_IA64",
                        "-DHAVE_ENCODER_LZMA1",
                        "-DHAVE_ENCODER_LZMA2",
                        "-DHAVE_ENCODER_POWERPC",
                        "-DHAVE_ENCODER_RISCV",
                        "-DHAVE_ENCODER_SPARC",
                        "-DHAVE_ENCODER_X86",
                        "-DHAVE_FUNC_ATTRIBUTE_CONSTRUCTOR",
                        "-DHAVE_INTTYPES_H",
                        "-DHAVE_LZIP_DECODER",
                        "-DHAVE_MF_BT2",
                        "-DHAVE_MF_BT3",
                        "-DHAVE_MF_BT4",
                        "-DHAVE_MF_HC3",
                        "-DHAVE_MF_HC4",
                        "-DHAVE_STDBOOL_H",
                        "-DHAVE_STDINT_H",
                        "-DHAVE_SYSCTLBYNAME",
                        "-DHAVE_SYS_PARAM_H",
                        "-DHAVE_VISIBILITY=0",
                        "-DHAVE__BOOL",
                        "-DHAVE___BUILTIN_ASSUME_ALIGNED",
                        "-DHAVE___BUILTIN_BSWAPXX",
                        "-DMYTHREAD_POSIX",
                        "-DPACKAGE_BUGREPORT=\"xz@tukaani.org\"",
                        "-DPACKAGE_NAME=\"XZ Utils\"",
                        "-DPACKAGE_URL=\"https://tukaani.org/xz/\"",
                        "-DTUKLIB_CPUCORES_SYSCTL",
                        "-DTUKLIB_FAST_UNALIGNED_ACCESS",
                        "-DTUKLIB_PHYSMEM_SYSCONF",
                        "-DTUKLIB_SYMBOL_PREFIX=lzma_",
                        "-D_ALL_SOURCE",
                        "-D_DARWIN_C_SOURCE",
                        "-D_GNU_SOURCE",
                        "-D_NETBSD_SOURCE",
                        "-D_OPENBSD_SOURCE",
                        "-D_POSIX_PTHREAD_SEMANTICS",
                        "-D_TANDEM_SOURCE",
                        "-D__EXTENSIONS__",
                        "-O2",
                        "-DNDEBUG",
                        "-std=gnu11",
                    },
                    .include = .{
                        "src:src/liblzma/api",
                        "src:src/liblzma/common",
                        "src:src/liblzma/check",
                        "src:src/liblzma/lz",
                        "src:src/liblzma/rangecoder",
                        "src:src/liblzma/lzma",
                        "src:src/liblzma/delta",
                        "src:src/liblzma/simple",
                        "src:src/common",
                    },
                    .path_flags = .{},
                    .files = .{
                        "src:src/common/tuklib_physmem.c",
                        "src:src/liblzma/check/check.c",
                        "src:src/liblzma/common/block_util.c",
                        "src:src/liblzma/common/common.c",
                        "src:src/liblzma/common/easy_preset.c",
                        "src:src/liblzma/common/filter_common.c",
                        "src:src/liblzma/common/hardware_physmem.c",
                        "src:src/liblzma/common/index.c",
                        "src:src/liblzma/common/stream_flags_common.c",
                        "src:src/liblzma/common/string_conversion.c",
                        "src:src/liblzma/common/vli_size.c",
                        "src:src/common/tuklib_cpucores.c",
                        "src:src/liblzma/common/hardware_cputhreads.c",
                        "src:src/liblzma/common/outqueue.c",
                        "src:src/liblzma/check/crc32_fast.c",
                        "src:src/liblzma/check/crc64_fast.c",
                        "src:src/liblzma/check/sha256.c",
                        "src:src/liblzma/common/alone_encoder.c",
                        "src:src/liblzma/common/block_buffer_encoder.c",
                        "src:src/liblzma/common/block_encoder.c",
                        "src:src/liblzma/common/block_header_encoder.c",
                        "src:src/liblzma/common/easy_buffer_encoder.c",
