+/* The words of a union real_extract U put into the fields of the CONST_DOUBLE R
+   from CONST_DOUBLE_LOW on, and taken out of them, one HOST_WIDE_INT a field.
+   They were copied as one block, which holds only where an rtx's field is as
+   wide as a HOST_WIDE_INT: on a host whose pointers are wider than int (LP64)
+   each field is wider, and a block copy loses every word after the first.  */
+#define REAL_EXTRACT_WORDS(u) (sizeof (u).i / sizeof (HOST_WIDE_INT))
+#define CONST_DOUBLE_FROM_EXTRACT(r, u)					\
+do { int w_;								\
+     for (w_ = 0; w_ < REAL_EXTRACT_WORDS (u); w_++)			\
+       XWINT ((r), 2 + w_) = (u).i[w_];					\
+   } while (0)
+#define CONST_DOUBLE_TO_EXTRACT(u, r)					\
+do { int w_;								\
+     for (w_ = 0; w_ < REAL_EXTRACT_WORDS (u); w_++)			\
+       (u).i[w_] = XWINT ((r), 2 + w_);					\
+   } while (0)
+
 /* For a CONST_DOUBLE:
    The usual two ints that hold the value.
    For a DImode, that is all there are;
