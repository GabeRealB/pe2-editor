// What the library's own build compiled for this host, harvested from it: each library's sources, in groups
// compiled alike. `src:` names a file of the sources, `build:` one its build generated (in `build/` here).
.{
    .libraries = .{
        .{
            .name = "fontconfig",
            .groups = .{
                .{
                    .kind = .c,
                    .flags = .{
                        "-DNDEBUG",
                        "-D_FILE_OFFSET_BITS=64",
                        "-std=c11",
                        "-O3",
                        "-DHAVE_CONFIG_H",
                        "-fPIC",
                        "-pthread",
                        "-DXML_STATIC",
                    },
                    .include = .{
                        "build:src/libpatternlib_internal.a.p",
                        "build:src",
                        "src:src",
                        "build:",
                        "src:",
                        "build:fc-lang",
                        "src:fc-lang",
                    },
                    .path_flags = .{},
                    .files = .{
                        "src:src/fcpat.c",
                    },
                },
                .{
                    .kind = .c,
                    .flags = .{
                        "-DNDEBUG",
                        "-D_FILE_OFFSET_BITS=64",
                        "-std=c11",
                        "-O3",
                        "-DHAVE_CONFIG_H",
                        "-fPIC",
                        "-pthread",
                        "-DXML_STATIC",
                    },
                    .include = .{
                        "build:libfontconfig.a.p",
                        "build:",
                        "src:",
                        "build:fc-lang",
                        "src:fc-lang",
                        "build:fc-case",
                        "build:fc-const",
                        "build:fc-genericfamily",
                        "build:src",
                    },
                    .path_flags = .{},
                    .files = .{
                        "src:src/fcatomic.c",
                        "src:src/fccache.c",
                        "src:src/fccfg.c",
                        "src:src/fccharset.c",
                        "src:src/fcconffile.c",
                        "src:src/fccompat.c",
                        "src:src/fcdbg.c",
                        "src:src/fcdefault.c",
                        "src:src/fcdir.c",
                        "src:src/fcformat.c",
                        "src:src/fcfreetype.c",
                        "src:src/fcfs.c",
                        "src:src/fcgenericalias.c",
                        "src:src/fcptrlist.c",
                        "src:src/fchash.c",
                        "src:src/fcinit.c",
                        "src:src/fclang.c",
                        "src:src/fclist.c",
                        "src:src/fcmatch.c",
                        "src:src/fcmatrix.c",
                        "src:src/fcname.c",
                        "src:src/fcobjs.c",
                        "src:src/fcrange.c",
                        "src:src/fcserialize.c",
                        "src:src/fcstat.c",
                        "src:src/fcstr.c",
                        "src:src/fcweight.c",
                        "src:src/fcxml.c",
                        "src:src/ftglue.c",
                    },
                },
            },
        },
    },
}
