// What the library's own build compiled for this host, harvested from it: each library's sources, in groups
// compiled alike. `src:` names a file of the sources, `build:` one its build generated (in `build/` here).
.{
    .libraries = .{
        .{
            .name = "ass",
            .groups = .{
                .{
                    .kind = .assembly,
                    .flags = .{
                        "-DNDEBUG",
                        "-std=gnu99",
                        "-O3",
                        "-D_GNU_SOURCE",
                        "-D_XPLATFORM_SOURCE",
                        "-fno-math-errno",
                        "-DPREFIX",
                    },
                    .include = .{
                        "build:libass/libass_asm.a.p",
                        "build:libass",
                        "src:libass",
                        "build:",
                        "src:",
                    },
                    .path_flags = .{},
                    .files = .{
                        "src:libass/aarch64/asm.S",
                        "src:libass/aarch64/be_blur.S",
                        "src:libass/aarch64/blend_bitmaps.S",
                        "src:libass/aarch64/blur.S",
                        "src:libass/aarch64/rasterizer.S",
                    },
                },
                .{
                    .kind = .c,
                    .flags = .{
                        "-DNDEBUG",
                        "-std=gnu99",
                        "-O3",
                        "-D_GNU_SOURCE",
                        "-D_XPLATFORM_SOURCE",
                        "-fno-math-errno",
                        "-DXML_STATIC",
                    },
                    .include = .{
                        "build:libass/libass.a.p",
                        "build:libass",
                        "src:libass",
                        "build:",
                        "src:",
                    },
                    .path_flags = .{},
                    .files = .{
                        "src:libass/c/c_be_blur.c",
                        "src:libass/c/c_blend_bitmaps.c",
                        "src:libass/c/c_blur.c",
                        "src:libass/c/c_rasterizer.c",
                        "src:libass/ass.c",
                        "src:libass/ass_arabic_charmap.c",
                        "src:libass/ass_bitmap.c",
                        "src:libass/ass_bitmap_engine.c",
                        "src:libass/ass_blur.c",
                        "src:libass/ass_cache.c",
                        "src:libass/ass_drawing.c",
                        "src:libass/ass_filesystem.c",
                        "src:libass/ass_font.c",
                        "src:libass/ass_fontselect.c",
                        "src:libass/ass_library.c",
                        "src:libass/ass_outline.c",
                        "src:libass/ass_parse.c",
                        "src:libass/ass_rasterizer.c",
                        "src:libass/ass_render.c",
                        "src:libass/ass_render_api.c",
                        "src:libass/ass_shaper.c",
                        "src:libass/ass_string.c",
                        "src:libass/ass_strtod.c",
                        "src:libass/ass_utils.c",
                        "src:libass/ass_fontconfig.c",
                    },
                },
            },
        },
    },
}
